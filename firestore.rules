rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dados da mesa (fichas, histórico, iniciativa, fila de animação):
    // qualquer conta autenticada do seu grupo pode ler e escrever.
    match /mesa/{documento} {
      allow read, write: if request.auth != null;
    }

    // Perfil (nome + papel) de cada conta: todo mundo autenticado pode ler
    // (pra mostrar nomes na mesa), mas só o dono da conta pode alterar o próprio perfil.
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
